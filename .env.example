# Copy to .env for local development. In production, set these in
# Vercel → Project → Settings → Environment Variables.

# Supabase → Connect → Transaction pooler (port 6543). Replace [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres

# The domain whose mail reaches the app.
DOMAIN=burnbox.sbs

# Signs in as the admin. Nobody can sign up with this email.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Optional: shown to users who want to upgrade while online payment isn't set up.
SUPPORT_EMAIL=

# Shared with the Cloudflare relay Worker. Generate with: openssl rand -hex 32
INBOUND_SECRET=

# Vercel sends this on cron requests. Generate with: openssl rand -hex 32
CRON_SECRET=
