{
  "name": "disposable-inbox",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply disposable-inbox --local",
    "db:migrate:remote": "wrangler d1 migrations apply disposable-inbox --remote",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "postal-mime": "^2.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261116.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
